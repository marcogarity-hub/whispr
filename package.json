{
  "name": "whispr-clone",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron electron/main.cjs",
    "dev": "VITE_DEV_SERVER_URL=http://localhost:5173 concurrently \"vite\" \"electron electron/main.cjs\"",
    "build": "vite build",
    "test": "node --test tests/**/*.test.cjs",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.mjs",
    "test:release": "npm test && npm run test:db && npm run build",
    "dev:web": "concurrently \"vite\" \"node --env-file=.env.local server/dev.cjs\"",
    "dev:oauth-check": "concurrently --kill-others \"vite\" \"node --env-file=.env.local scripts/local-oauth-check.mjs\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^4.21.2",
    "google-auth-library": "11.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "jsdom": "26.1.0",
    "pg": "8.23.1",
    "vite": "^6.1.0"
  }
}
